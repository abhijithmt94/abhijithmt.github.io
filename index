<!-- HERO -->
<section class="hero" id="home">
  <div class="wrap hero-inner">
    <div>
      <div class="eyebrow">Green Energy Technology · Pondicherry University</div>
      <h1>Abhijith <em>M. T.</em></h1>
      <div class="role">Thermal Energy Storage &amp; Solar Thermal Energy Researcher</div>
      <p class="intro">
        Researcher working at the boundary of phase change materials, high-temperature thermal
        energy storage and solar thermal devices — building the physical and computational
        understanding needed to store heat efficiently, from building comfort systems to
        concentrated solar power.
      </p>
      <div class="tag-row">
        <span class="tag">Thermal Energy Storage</span>
        <span class="tag">Phase Change Materials</span>
        <span class="tag">Solar Thermal Energy</span>
        <span class="tag">High-Temperature TES</span>
        <span class="tag">Heat Exchangers</span>
        <span class="tag">CFD / ANSYS Fluent</span>
        <span class="tag">Sustainable Energy Technologies</span>
      </div>
      <div class="cta-row">
        <a href="#research" class="btn btn-primary">View My Research</a>
        <a href="#publications" class="btn btn-outline">Publications</a>
        <a href="documents/Abhijith_MT_CV.pdf" class="btn btn-outline" download>Download CV</a>
        <a href="#contact" class="btn btn-ghost">Contact Me</a>
      </div>
    </div>

    <div class="curve-card">
      <div class="label">Latent heat charging curve — signature of my PhD work</div>
      <svg viewBox="0 0 360 190" preserveAspectRatio="xMidYMid meet">
        <line x1="20" y1="160" x2="340" y2="160" stroke="var(--line)" stroke-width="1"/>
        <line x1="20" y1="20" x2="20" y2="160" stroke="var(--line)" stroke-width="1"/>
        <path class="phase-path" d="M20,150 C 70,140 100,120 120,95 C 140,68 150,50 175,50 C 200,50 210,68 230,95 C 255,125 290,140 340,55"
              fill="none" stroke="url(#curveGrad)" stroke-width="3" stroke-linecap="round"/>
        <defs>
          <linearGradient id="curveGrad" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#1f6f78"/>
            <stop offset="45%" stop-color="#d6a441"/>
            <stop offset="100%" stop-color="#c4622b"/>
          </linearGradient>
        </defs>
