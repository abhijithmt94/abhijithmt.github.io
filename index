<style>
  :root{
    --ink:#101a24;
    --ink-soft:#3a4552;
    --paper:#f6f3ec;
    --paper-raised:#ffffff;
    --line:#dcd6c8;
    --ember:#c4622b;
    --ember-deep:#9c4a1f;
    --teal:#1f6f78;
    --teal-deep:#164f56;
    --muted:#7b8290;
    --radius:2px;
    --grad: linear-gradient(90deg, var(--teal) 0%, var(--teal) 22%, #d6a441 55%, var(--ember) 78%, var(--ember-deep) 100%);
  }

  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  @media (prefers-reduced-motion: reduce){
    html{scroll-behavior:auto;}
    *{animation-duration:0.01ms !important; animation-iteration-count:1 !important; transition-duration:0.01ms !important;}
  }

  body{
    margin:0;
    background:var(--paper);
    color:var(--ink);
    font-family:'IBM Plex Sans', sans-serif;
    font-size:16px;
    line-height:1.6;
    -webkit-font-smoothing:antialiased;
  }

  h1,h2,h3,h4{
    font-family:'Fraunces', serif;
    color:var(--ink);
    margin:0;
    letter-spacing:-0.01em;
  }

  a{color:inherit;text-decoration:none;}
  img{max-width:100%;display:block;}

  ::selection{background:var(--ember); color:#fff;}

  .mono{font-family:'IBM Plex Mono', monospace;}

  .eyebrow{
    font-family:'IBM Plex Mono', monospace;
    font-size:0.72rem;
    letter-spacing:0.18em;
    text-transform:uppercase;
    color:var(--teal-deep);
    display:flex;
    align-items:center;
    gap:0.6rem;
  }
  .eyebrow::before{
    content:"";
    width:22px;
    height:2px;
    background:var(--grad);
    display:inline-block;
  }

  .wrap{max-width:1120px; margin:0 auto; padding:0 32px;}

  /* ---------- NAV ---------- */
  header.site-nav{
    position:sticky; top:0; z-index:100;
    background:rgba(246,243,236,0.92);
    backdrop-filter:blur(8px);
    border-bottom:1px solid var(--line);
  }
  .nav-inner{
    max-width:1120px; margin:0 auto; padding:0 32px;
    display:flex; align-items:center; justify-content:space-between;
    height:64px;
  }
  .nav-brand{
    font-family:'Fraunces', serif;
    font-weight:600;
    font-size:1.05rem;
    display:flex; align-items:center; gap:10px;
  }
  .nav-brand .dot{
    width:9px;height:9px;border-radius:50%;
    background:var(--grad);
    flex:none;
  }
  .nav-links{
    display:flex; gap:28px;
    list-style:none; margin:0; padding:0;
  }
  .nav-links a{
    font-size:0.86rem; font-weight:500; color:var(--ink-soft);
    position:relative; padding:4px 0;
    transition:color .2s ease;
  }
  .nav-links a:hover{color:var(--ember-deep);}
  .nav-links a::after{
    content:""; position:absolute; left:0; bottom:-2px;
    width:0; height:2px; background:var(--grad);
    transition:width .25s ease;
  }
  .nav-links a:hover::after{width:100%;}
  .nav-toggle{display:none; background:none; border:none; cursor:pointer; padding:8px;}
  .nav-toggle span{display:block; width:22px; height:2px; background:var(--ink); margin:5px 0; transition:.25s;}

  @media (max-width:860px){
    .nav-links{
      position:fixed; top:64px; left:0; right:0;
      background:var(--paper-raised);
      flex-direction:column; gap:0;
      max-height:0; overflow:hidden;
      border-bottom:1px solid var(--line);
      transition:max-height .3s ease;
    }
    .nav-links.open{max-height:520px;}
    .nav-links li{border-top:1px solid var(--line);}
    .nav-links a{display:block; padding:14px 32px;}
    .nav-toggle{display:block;}
  }

  /* ---------- HERO ---------- */
  .hero{
    position:relative;
    padding:96px 0 76px;
    overflow:hidden;
  }
  .hero::before{
    content:"";
    position:absolute; inset:0;
    background:
      radial-gradient(600px 300px at 85% -10%, rgba(196,98,43,0.10), transparent 60%),
      radial-gradient(500px 260px at -5% 10%, rgba(31,111,120,0.10), transparent 60%);
    pointer-events:none;
  }
  .hero-inner{position:relative; display:grid; grid-template-columns:1.15fr 0.85fr; gap:56px; align-items:center;}
  @media (max-width:900px){.hero-inner{grid-template-columns:1fr;}}

  .hero h1{
    font-size:clamp(2.4rem, 5vw, 3.6rem);
    line-height:1.04;
    font-weight:500;
  }
  .hero h1 em{
    font-style:italic; font-weight:500;
    background:linear-gradient(90deg, var(--teal-deep), var(--ember-deep));
    -webkit-background-clip:text; background-clip:text; color:transparent;
  }
  .hero .role{
    margin-top:14px;
    font-size:1.12rem;
    color:var(--ink-soft);
    font-weight:500;
  }
  .hero p.intro{
    margin-top:22px;
    max-width:56ch;
    color:var(--ink-soft);
    font-size:1rem;
  }

  .tag-row{display:flex; flex-wrap:wrap; gap:9px; margin-top:26px;}
  .tag{
    font-family:'IBM Plex Mono', monospace;
    font-size:0.74rem;
    padding:6px 11px;
    border:1px solid var(--line);
    background:var(--paper-raised);
    color:var(--ink-soft);
    border-radius:var(--radius);
  }

  .cta-row{display:flex; flex-wrap:wrap; gap:12px; margin-top:34px;}
  .btn{
    display:inline-flex; align-items:center; gap:8px;
    padding:12px 20px;
    font-size:0.88rem; font-weight:600;
    border-radius:var(--radius);
    border:1px solid transparent;
    cursor:pointer;
    transition:transform .18s ease, box-shadow .18s ease, background .18s ease, color .18s ease;
  }
  .btn-primary{background:var(--ink); color:var(--paper);}
  .btn-primary:hover{background:var(--ember-deep); transform:translateY(-2px);}
  .btn-outline{border-color:var(--ink); color:var(--ink); background:transparent;}
  .btn-outline:hover{background:var(--ink); color:var(--paper); transform:translateY(-2px);}
  .btn-ghost{color:var(--teal-deep); border-color:var(--teal-deep);}
  .btn-ghost:hover{background:var(--teal-deep); color:#fff; transform:translateY(-2px);}

  /* Thermal signature curve */
  .curve-card{
    background:var(--paper-raised);
    border:1px solid var(--line);
    border-radius:var(--radius);
    padding:26px 24px 20px;
    box-shadow:0 18px 40px -24px rgba(16,26,36,0.35);
  }
  .curve-card .label{
    font-family:'IBM Plex Mono', monospace;
    font-size:0.68rem; letter-spacing:0.12em; text-transform:uppercase;
    color:var(--muted); margin-bottom:6px;
  }
  .curve-card svg{width:100%; height:auto; display:block;}
  .curve-legend{
    display:flex; justify-content:space-between;
    font-family:'IBM Plex Mono', monospace;
    font-size:0.66rem; color:var(--muted);
    margin-top:10px;
  }
  .phase-path{
    stroke-dasharray:600;
    stroke-dashoffset:600;
    animation:draw 2.2s ease forwards .3s;
  }
  @keyframes draw{to{stroke-dashoffset:0;}}

  /* ---------- SECTION SCAFFOLD ---------- */
  section{padding:88px 0;}
  section + section{border-top:1px solid var(--line);}
  .section-head{margin-bottom:44px; max-width:64ch;}
  .section-head h2{font-size:clamp(1.7rem,3vw,2.3rem); font-weight:500; margin-top:10px;}
  .section-head p{color:var(--ink-soft); margin-top:14px;}

  .reveal{opacity:0; transform:translateY(18px); transition:opacity .7s ease, transform .7s ease;}
  .reveal.in{opacity:1; transform:none;}

  /* ---------- ABOUT ---------- */
  .about-grid{display:grid; grid-template-columns:0.9fr 1.1fr; gap:52px;}
  @media (max-width:860px){.about-grid{grid-template-columns:1fr;}}
  .profile-frame{
    aspect-ratio:4/5; background:var(--paper-raised);
    border:1px solid var(--line); border-radius:var(--radius);
    display:flex; align-items:center; justify-content:center;
    color:var(--muted); font-family:'IBM Plex Mono', monospace; font-size:0.78rem;
    text-align:center; padding:24px; position:relative; overflow:hidden;
  }
  .profile-frame::after{
    content:""; position:absolute; left:0; right:0; bottom:0; height:5px; background:var(--grad);
  }
  .about-text p{color:var(--ink-soft); margin:0 0 16px;}
  .stat-strip{display:grid; grid-template-columns:repeat(4,1fr); gap:1px; background:var(--line); margin-top:32px; border:1px solid var(--line);}
  .stat{background:var(--paper-raised); padding:20px 16px; text-align:center;}
  .stat .num{font-family:'Fraunces', serif; font-size:1.9rem; color:var(--ember-deep);}
  .stat .lbl{font-family:'IBM Plex Mono', monospace; font-size:0.66rem; text-transform:uppercase; letter-spacing:0.08em; color:var(--muted); margin-top:4px;}
  @media (max-width:640px){.stat-strip{grid-template-columns:repeat(2,1fr);}}

  /* ---------- POSITION CARD ---------- */
  .position-card{
    background:var(--ink); color:var(--paper);
    border-radius:var(--radius);
    padding:44px;
    position:relative;
    overflow:hidden;
  }
  .position-card::before{
    content:""; position:absolute; inset:0;
    background:linear-gradient(120deg, rgba(31,111,120,0.35), transparent 55%, rgba(196,98,43,0.30));
  }
  .position-card > *{position:relative;}
  .position-card .eyebrow{color:#d6a441;}
  .position-card .eyebrow::before{background:var(--grad);}
  .position-card h3{color:#fff; font-size:1.5rem; margin-top:12px; font-weight:500;}
  .position-card .org{color:#c9d2da; margin-top:6px; font-size:0.98rem;}
  .position-card .proj{
    margin-top:20px; padding:18px 20px;
    background:rgba(255,255,255,0.06);
    border-left:3px solid var(--ember);
    font-style:italic; color:#e9e4d8;
  }
  .position-card .ref{
    margin-top:18px; font-family:'IBM Plex Mono', monospace; font-size:0.78rem; color:#a9b3bd;
  }

  /* ---------- TIMELINE (education / experience) ---------- */
  .timeline{position:relative; padding-left:32px;}
  .timeline::before{
    content:""; position:absolute; left:5px; top:6px; bottom:6px; width:2px;
    background:linear-gradient(var(--teal), var(--ember));
  }
  .t-item{position:relative; padding-bottom:38px;}
  .t-item:last-child{padding-bottom:0;}
  .t-item::before{
    content:""; position:absolute; left:-32px; top:4px;
    width:12px; height:12px; border-radius:50%;
    background:var(--paper); border:2px solid var(--ember);
  }
  .t-year{font-family:'IBM Plex Mono', monospace; font-size:0.76rem; color:var(--ember-deep); font-weight:500;}
  .t-title{font-family:'Fraunces', serif; font-size:1.18rem; margin-top:4px; font-weight:500;}
  .t-org{color:var(--ink-soft); font-size:0.94rem; margin-top:2px;}
  .t-desc{color:var(--ink-soft); font-size:0.92rem; margin-top:8px; max-width:60ch;}
  .t-result{
    display:inline-block; margin-top:8px; font-family:'IBM Plex Mono', monospace;
    font-size:0.72rem; color:var(--teal-deep); background:rgba(31,111,120,0.08);
    padding:3px 9px; border-radius:var(--radius);
  }

  .thesis-box{
    margin-top:44px; padding:28px 30px; background:var(--paper-raised);
    border:1px solid var(--line); border-left:4px solid var(--teal);
  }
  .thesis-box .eyebrow{margin-bottom:10px;}
  .thesis-box .title{font-family:'Fraunces', serif; font-style:italic; font-size:1.25rem; line-height:1.4;}
  .thesis-box .meta{margin-top:10px; color:var(--muted); font-size:0.85rem;}

  /* ---------- RESEARCH CARDS ---------- */
  .card-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:22px;}
  @media (max-width:900px){.card-grid{grid-template-columns:repeat(2,1fr);}}
  @media (max-width:600px){.card-grid{grid-template-columns:1fr;}}
  .rcard{
    background:var(--paper-raised); border:1px solid var(--line);
    padding:26px 22px; border-radius:var(--radius);
    transition:transform .2s ease, box-shadow .2s ease, border-color .2s ease;
  }
  .rcard:hover{transform:translateY(-4px); box-shadow:0 20px 34px -26px rgba(16,26,36,0.45); border-color:var(--teal);}
  .rcard .idx{font-family:'IBM Plex Mono', monospace; font-size:0.72rem; color:var(--ember-deep);}
  .rcard h4{font-size:1.02rem; margin-top:10px; font-weight:600; font-family:'IBM Plex Sans', sans-serif;}
  .rcard p{color:var(--muted); font-size:0.86rem; margin-top:8px;}

  /* ---------- PUBLICATIONS ---------- */
  .pub-group{margin-bottom:46px;}
  .pub-group:last-child{margin-bottom:0;}
  .pub-group-title{
    font-family:'IBM Plex Mono', monospace; font-size:0.78rem; text-transform:uppercase;
    letter-spacing:0.1em; color:var(--ink-soft); margin-bottom:18px;
    display:flex; align-items:center; gap:12px;
  }
  .pub-group-title::after{content:""; flex:1; height:1px; background:var(--line);}
  .pub{
    background:var(--paper-raised); border:1px solid var(--line);
    padding:22px 24px; margin-bottom:14px; border-radius:var(--radius);
    display:flex; flex-direction:column; gap:8px;
  }
  .pub-badges{display:flex; gap:8px; flex-wrap:wrap;}
  .badge{
    font-family:'IBM Plex Mono', monospace; font-size:0.66rem; text-transform:uppercase;
    letter-spacing:0.06em; padding:3px 9px; border-radius:var(--radius);
  }
  .badge-journal{background:rgba(31,111,120,0.12); color:var(--teal-deep);}
  .badge-review{background:rgba(196,98,43,0.13); color:var(--ember-deep);}
  .badge-chapter{background:rgba(214,164,65,0.18); color:#8a6413;}
  .badge-conf{background:rgba(16,26,36,0.07); color:var(--ink-soft);}
  .pub-title{font-size:1rem; font-weight:600; line-height:1.5;}
  .pub-meta{color:var(--muted); font-size:0.85rem;}
  .pub-actions{margin-top:4px;}
  .pub-actions a{
    font-family:'IBM Plex Mono', monospace; font-size:0.74rem; color:var(--muted);
    border:1px dashed var(--line); padding:4px 9px; border-radius:var(--radius);
  }

  /* ---------- SKILLS ---------- */
  .skill-cats{display:grid; grid-template-columns:repeat(2,1fr); gap:22px;}
  @media (max-width:760px){.skill-cats{grid-template-columns:1fr;}}
  .skill-cat{background:var(--paper-raised); border:1px solid var(--line); padding:26px;}
  .skill-cat h4{font-size:1.02rem; font-weight:600; font-family:'IBM Plex Sans',sans-serif; margin-bottom:14px; color:var(--teal-deep);}
  .skill-chips{display:flex; flex-wrap:wrap; gap:8px;}
  .chip{
    font-size:0.8rem; padding:6px 12px; background:var(--paper);
    border:1px solid var(--line); border-radius:20px; color:var(--ink-soft);
    transition:.2s ease;
  }
  .chip:hover{border-color:var(--ember); color:var(--ember-deep);}

  /* ---------- TEACHING / ACHIEVEMENTS ---------- */
  .two-col{display:grid; grid-template-columns:1fr 1fr; gap:22px;}
  @media (max-width:760px){.two-col{grid-template-columns:1fr;}}
  .list-card{background:var(--paper-raised); border:1px solid var(--line); padding:26px;}
  .list-card h4{font-family:'Fraunces', serif; font-weight:500; font-size:1.1rem; margin-bottom:14px;}
  .list-card ul{margin:0; padding-left:18px; color:var(--ink-soft); font-size:0.92rem;}
  .list-card li{margin-bottom:10px;}
  .list-card li:last-child{margin-bottom:0;}
  .list-card .dates{color:var(--muted); font-family:'IBM Plex Mono', monospace; font-size:0.78rem;}

  /* ---------- CV ---------- */
  .cv-panel{
    background:linear-gradient(120deg, var(--teal-deep), var(--ink) 70%);
    color:#fff; border-radius:var(--radius); padding:56px;
    display:flex; align-items:center; justify-content:space-between; gap:24px; flex-wrap:wrap;
  }
  .cv-panel h3{color:#fff; font-size:1.5rem; font-weight:500;}
  .cv-panel p{color:#cfd6da; margin-top:8px; max-width:44ch;}
  .cv-panel .btn-primary{background:var(--ember);}
  .cv-panel .btn-primary:hover{background:#e07a3d;}

  /* ---------- CONTACT ---------- */
  .contact-grid{display:grid; grid-template-columns:1fr 1fr; gap:22px;}
  @media (max-width:760px){.contact-grid{grid-template-columns:1fr;}}
  .contact-card{background:var(--paper-raised); border:1px solid var(--line); padding:22px 24px;}
  .contact-card .k{font-family:'IBM Plex Mono', monospace; font-size:0.68rem; text-transform:uppercase; letter-spacing:0.1em; color:var(--muted);}
  .contact-card .v{margin-top:8px; font-size:0.98rem; word-break:break-word;}
  .social-row{display:flex; flex-wrap:wrap; gap:12px; margin-top:34px;}
  .social-row a{
    font-family:'IBM Plex Mono', monospace; font-size:0.8rem;
    padding:9px 16px; border:1px solid var(--line); border-radius:var(--radius);
    color:var(--ink-soft); transition:.2s ease;
  }
  .social-row a:hover{border-color:var(--ember); color:var(--ember-deep);}

  footer{
    padding:36px 0; text-align:center; color:var(--muted); font-size:0.82rem;
    border-top:1px solid var(--line);
  }
</style>
</head>
